root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{csproj,props,targets,json,yml,yaml,slnx}]
indent_size = 2

# EF Core generates these; analyzers and style rules do not apply.
[**/Migrations/*.cs]
generated_code = true
dotnet_analyzer_diagnostic.severity = none
