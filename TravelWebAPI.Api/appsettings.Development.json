{
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://localhost:5174"
    ]
  },
  "Jwt": {
    "Key": "development-only-signing-key-0123456789-abcdefghij"
  },
  "App": {
    "WebBaseUrl": "http://localhost:5173"
  },
  "Seed": {
    "Enabled": true,
    "IncludeSampleActivity": true
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information"
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ]
  },
  "Email": {
    "LogBodies": true
  }
}
