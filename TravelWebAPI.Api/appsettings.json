{
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": ""
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Jwt": {
    "Key": "",
    "Issuer": "TravelWebAPI",
    "Audience": "TravelWebAPI",
    "AccessTokenMinutes": 15
  },
  "App": {
    "WebBaseUrl": ""
  },
  "Auth": {
    "MaxFailedAttempts": 5,
    "LockoutMinutes": 15,
    "RefreshDays": 1,
    "RefreshDaysRemember": 30,
    "RefreshGraceSeconds": 10,
    "ResetTokenMinutes": 60
  },
  "RateLimiting": {
    "AuthPermitLimit": 10,
    "AuthWindowSeconds": 60
  },
  "Hosting": {
    "UseForwardedHeaders": false,
    "KnownProxies": []
  },
  "Seed": {
    "Enabled": false,
    "IncludeSampleActivity": true
  },
  "Limits": {
    "MaxRequestBodyBytes": 1048576
  },
  "Storage": {
    "UploadsPath": "uploads"
  },
  "Email": {
    "SendGridApiKey": "",
    "FromEmail": "",
    "FromName": "",
    "OwnerEmail": ""
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.RenderedCompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ]
  }
}
