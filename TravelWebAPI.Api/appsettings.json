{
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": ""
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Jwt": {
    "Key": "",
    "Issuer": "TravelWebAPI",
    "Audience": "TravelWebAPI",
    "AccessTokenMinutes": 15
  },
  "Seed": {
    "Enabled": false,
    "IncludeSampleActivity": true
  },
  "Limits": {
    "MaxRequestBodyBytes": 1048576
  },
  "Email": {
    "SendGridApiKey": "",
    "FromEmail": "",
    "FromName": "",
    "OwnerEmail": ""
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.RenderedCompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ]
  }
}
